# Copy to .env (never committed or uploaded). The deployed app reads these from Modal secrets instead.
# Your RapidAPI key for AeroDataBox (Basic free plan)
AERODATABOX_KEY=
# Optional: the Supabase Session pooler URI. Without it, ../dashboard/.env is used, then a local SQLite file.
# DASHBOARD_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
