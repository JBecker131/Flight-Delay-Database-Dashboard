# Set these in Vercel: Project Settings -> Environment Variables (or `vercel env add`).
# The same PREDICT_API_KEY as the Modal secret "flight-delay-api". Required: /predict refuses calls without it.
PREDICT_API_KEY=

# Optional overrides; the defaults are the deployed Modal apps.
